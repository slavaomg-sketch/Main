{
  "name": "RiftRacers",
  "globIgnorePaths": [
    "**/*.spec.luau",
    "**/.gitkeep"
  ],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/ServerScriptService/Server"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "Content": {
        "$path": "src/ServerStorage/Content"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/Client"
        }
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ResetPlayerGuiOnSpawn": false
      },
      "RiftRacersUI": {
        "$path": "src/StarterGui/RiftRacersUI"
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false
      },
      "RiftRacers": {
        "$className": "Folder",
        "Tracks": {
          "$className": "Folder"
        },
        "Vehicles": {
          "$className": "Folder"
        },
        "Projectiles": {
          "$className": "Folder"
        },
        "Lobby": {
          "$className": "Folder"
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Brightness": 2,
        "ClockTime": 14.5,
        "GlobalShadows": true,
        "Technology": "Future"
      }
    },
    "SoundService": {
      "$className": "SoundService"
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": false
      }
    }
  }
}