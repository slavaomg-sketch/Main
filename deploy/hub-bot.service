# Юнит для бота-хаба (ветка «Доставка» и всё, что добавите дальше).
# Ставится рядом с reminder-bot.service: отдельный процесс и отдельный бот от @BotFather.
#
# Плейсхолдеры подставляются одной командой (см. TRACKER.md):
#   sed -e 's|__APP_DIR__|/opt/reminder-bot|g' -e 's|__APP_USER__|reminderbot|g' \
#       deploy/hub-bot.service | sudo tee /etc/systemd/system/hub-bot.service

[Unit]
Description=Telegram hub bot (delivery tracker and other branches)
Documentation=https://github.com/slavaomg-sketch/Main
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/.venv/bin/python -m hub

Restart=always
RestartSec=10
# Если бот падает при старте (например, неверный токен) — не долбиться бесконечно.
StartLimitIntervalSec=300
StartLimitBurst=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hub-bot

# Нужен только исходящий HTTPS и своя папка data — остальное закрываем.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__APP_DIR__/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
