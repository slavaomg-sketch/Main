# ============================================================================
#  Веб-панель маркетплейсов
# ============================================================================

# ---- Доступ ----
# Пароль для входа в панель. Пусто — панель открыта всем, у кого есть адрес.
# Если сервер смотрит в интернет — задайте пароль обязательно.
DASHBOARD_PASSWORD=

# Секрет для подписи cookie сессии. Установщик генерирует случайный.
DASHBOARD_SECRET=change-me-in-production

# ---- Сеть и хранение ----
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_DB_PATH=data/dashboard.db

# Сколько секунд держать ответ маркетплейса в кэше (бережёт лимиты их API)
DASHBOARD_CACHE_TTL=300

# Таймаут запроса к API маркетплейса, секунды
DASHBOARD_HTTP_TIMEOUT=30

# 1 — принудительно показывать демо-данные, даже если ключи заданы
DASHBOARD_DEMO=0

# ---- Ключи маркетплейсов ----
# Любую площадку можно не заполнять: без ключей она работает на демо-данных.

# Wildberries → Личный кабинет → Настройки → Доступ к API (нужна «Статистика»)
WB_API_TOKEN=

# Ozon → Seller → Настройки → API-ключи
OZON_CLIENT_ID=
OZON_API_KEY=

# Яндекс Маркет → Кабинет продавца → Настройки → API
YANDEX_API_KEY=
YANDEX_BUSINESS_ID=
YANDEX_CAMPAIGN_ID=

# AliExpress → Open Platform (openservice.aliexpress.com)
ALI_APP_KEY=
ALI_APP_SECRET=
ALI_ACCESS_TOKEN=


# ============================================================================
#  Телеграм-бот напоминаний (отдельная программа, панели не нужен)
# ============================================================================

# Токен бота из @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789

# Путь к файлу базы бота
DB_PATH=data/bot.db

# Часовой пояс по умолчанию для новых сотрудников
DEFAULT_TZ=Europe/Moscow

# Во сколько администраторам приходит отчёт за день (в часовом поясе админа)
REPORT_TIME=20:00

# Через сколько минут после напоминания прислать "толчок", если сотрудник не отметился.
# 0 — отключить повторное напоминание.
NUDGE_AFTER_MINUTES=60

# Окно "догона": если бот был выключен, напоминание всё равно уйдёт,
# если с его времени прошло не больше указанного количества минут.
CATCHUP_MINUTES=15
