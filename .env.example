# ==============================================================
# TechMatch — переменные окружения (скопируйте в .env)
# Реальные ключи НИКОГДА не коммитить.
# ==============================================================

NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# --- База данных ---
DATABASE_URL=postgresql://techmatch:techmatch@localhost:5432/techmatch?schema=public
# Отдельная база для интеграционных тестов
TEST_DATABASE_URL=postgresql://techmatch:techmatch@localhost:5432/techmatch_test?schema=public

# --- Redis / очереди ---
# QUEUE_DRIVER=inline — фоновые задачи выполняются в процессе web (dev без Redis)
# QUEUE_DRIVER=bullmq — задачи уходят в Redis, их выполняет apps/worker
QUEUE_DRIVER=inline
REDIS_URL=redis://localhost:6379

# --- Сессии и безопасность ---
# Минимум 32 случайных символа: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_SESSION_TTL_HOURS=12
CUSTOMER_SESSION_TTL_DAYS=30
# Секрет для подписи cookie корзины гостя
CART_COOKIE_SECRET=change-me-too-random-32-chars-minimum
# Rate limiting (запросов в окно)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=60

# --- Хранилище медиа ---
# MEDIA_DRIVER=local — файлы лежат в ./storage/media и раздаются через /media/*
# MEDIA_DRIVER=s3 — S3-совместимое хранилище
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=./storage/media
MEDIA_PUBLIC_BASE_URL=/media
S3_ENDPOINT=
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
UPLOAD_MAX_IMAGE_MB=8
# Стандарт товарного фото (см. docs/IMAGE_STANDARD.md): квадрат 1:1, объект по центру, единые поля, белый фон.
# IMAGE_NORMALIZE=true — все загружаемые фото товаров/устройств приводятся к стандарту при сохранении.
IMAGE_NORMALIZE=true
# Внешняя команда удаления фона (опционально). Плейсхолдеры {input} и {output} заменяются путями к файлам.
# Пример с rembg (pip install "rembg[cpu]"): IMAGE_CUTOUT_COMMAND=rembg i -m isnet-general-use {input} {output}
IMAGE_CUTOUT_COMMAND=

# --- Платежи ---
# PAYMENT_PROVIDER=mock — тестовая оплата с локальной страницей подтверждения
# PAYMENT_PROVIDER=yookassa — включится только при наличии ключей ниже
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Секрет для подписи входящих webhook mock-провайдера
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
ORDER_RESERVATION_TTL_MINUTES=30

# --- Доставка ---
# DELIVERY_PROVIDER=mock | cdek
DELIVERY_PROVIDER=mock
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=
CDEK_SENDER_CITY_CODE=44

# --- Уведомления ---
# NOTIFICATION_PROVIDER=console | smtp
NOTIFICATION_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="TechMatch <noreply@techmatch.local>"

# --- Фискализация (чеки 54-ФЗ) ---
# FISCAL_PROVIDER=mock | atol
FISCAL_PROVIDER=mock
ATOL_LOGIN=
ATOL_PASSWORD=
ATOL_GROUP_CODE=

# --- Маркетплейсы (только через официальные API; пусто = адаптер выключен) ---
WILDBERRIES_API_TOKEN=
OZON_CLIENT_ID=
OZON_API_KEY=
YANDEX_MARKET_OAUTH_TOKEN=
YANDEX_MARKET_CAMPAIGN_ID=

# --- LLM-помощник (необязательно; только разбор запроса и объяснения, не вердикт) ---
LLM_PROVIDER=none
ANTHROPIC_API_KEY=

# --- Seed ---
SEED_ADMIN_EMAIL=admin@techmatch.local
SEED_ADMIN_PASSWORD=Admin12345!
SEED_CUSTOMER_EMAIL=customer@techmatch.local
SEED_CUSTOMER_PASSWORD=Customer12345!
