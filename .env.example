# ---- Обязательное ----
# Токен бота из @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789

# ---- Необязательное ----
# Путь к файлу базы данных
DB_PATH=data/bot.db

# Часовой пояс по умолчанию для новых сотрудников
DEFAULT_TZ=Europe/Moscow

# Во сколько администраторам приходит отчёт за день (в часовом поясе админа)
REPORT_TIME=20:00

# Через сколько минут после напоминания прислать "толчок", если сотрудник не отметился.
# 0 — отключить повторное напоминание.
NUDGE_AFTER_MINUTES=60

# Окно "догона": если бот был выключен, напоминание всё равно уйдёт,
# если с его времени прошло не больше указанного количества минут.
CATCHUP_MINUTES=15

# ---- Конвейер карточек (pipeline/) ----
# Токен GitHub с правом записи в этот репозиторий (fine-grained, Contents: Read and write).
# Нужен, чтобы сервер забирал идеи и пушил готовые карточки.
GITHUB_TOKEN=
# Ветка, в которой живут ideas/ и cards/
PIPELINE_BRANCH=main
# Как часто проверять очередь, секунд
PIPELINE_POLL_SECONDS=300
# Надписи на картинках: overlay — накладывает скрипт (точное написание),
# native — рисует gpt-image-2, both — оба варианта (native лежит в images/native/)
IMAGE_TEXT_MODE=both
# Слайдов инфографики помимо главного фото
SLIDES_PER_CARD=3
# Ограничения; 0 — без ограничений
MAX_IDEAS_PER_RUN=0
MAX_IMAGES_PER_DAY=0
# Модель Claude для текстов; пусто — по умолчанию из настроек claude
CLAUDE_MODEL=
# Аргументы codex exec (по умолчанию --full-auto --skip-git-repo-check)
CODEX_EXTRA_ARGS=--full-auto --skip-git-repo-check
# Уведомления в Telegram (использует BOT_TOKEN и ADMIN_IDS выше)
PIPELINE_NOTIFY=1
