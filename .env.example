# ---- Обязательное ----
# Токен бота из @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789

# ---- Необязательное ----
# Путь к файлу базы данных
DB_PATH=data/bot.db

# Часовой пояс по умолчанию для новых сотрудников
DEFAULT_TZ=Europe/Moscow

# Во сколько администраторам приходит отчёт за день (в часовом поясе админа)
REPORT_TIME=20:00

# Через сколько минут после напоминания прислать "толчок", если сотрудник не отметился.
# 0 — отключить повторное напоминание.
NUDGE_AFTER_MINUTES=60

# Окно "догона": если бот был выключен, напоминание всё равно уйдёт,
# если с его времени прошло не больше указанного количества минут.
CATCHUP_MINUTES=15

# ---- Трекер доставок (см. TRACKER.md) ----
# Боту не нужны, программа запускается отдельно.

# За сколько минут до прибытия напоминать по умолчанию (можно несколько: 15,5)
TRACKER_ALERTS=5

# Чем напоминать по умолчанию: console, banner, reminders, calendar, ics, telegram
TRACKER_NOTIFIERS=console

# Файл со списком отслеживаемых поездок и папка для .ics
TRACKER_STATE=data/trips.json
TRACKER_ICS_DIR=data/ics

# Куда класть записи на macOS. Пусто — список и календарь по умолчанию.
TRACKER_REMINDERS_LIST=
TRACKER_CALENDAR=

# Кому слать при --notify telegram. Пусто — берётся BOT_TOKEN и первый ADMIN_IDS.
TRACKER_BOT_TOKEN=
TRACKER_CHAT_ID=
