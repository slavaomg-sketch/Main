{
  "name": "@techmatch/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "default": "./src/*/index.ts"
    },
    "./shared/*": {
      "types": "./src/shared/*.ts",
      "default": "./src/shared/*.ts"
    },
    "./orders/state": {
      "types": "./src/orders/state.ts",
      "default": "./src/orders/state.ts"
    },
    "./admin/rbac": {
      "types": "./src/admin/rbac.ts",
      "default": "./src/admin/rbac.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@techmatch/config": "workspace:*",
    "@techmatch/database": "workspace:*",
    "@techmatch/integrations": "workspace:*",
    "@techmatch/validation": "workspace:*",
    "csv-stringify": "^6.8.3",
    "sharp": "^0.34.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@techmatch/testing": "workspace:*",
    "dotenv": "^17.4.2",
    "eslint": "^9.30.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
