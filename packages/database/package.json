{
  "name": "@techmatch/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./seed-data": {
      "types": "./src/seed/data/index.ts",
      "default": "./src/seed/data/index.ts"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:status": "dotenv -e ../../.env -- prisma migrate status",
    "reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "seed": "dotenv -e ../../.env -- tsx src/seed/index.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "echo \"no tests\""
  },
  "prisma": {
    "seed": "dotenv -e ../../.env -- tsx src/seed/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@techmatch/config": "workspace:*"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.30.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
